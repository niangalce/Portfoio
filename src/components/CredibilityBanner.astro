---
interface Props {
  lang?: 'fr' | 'en';
}

const { lang = 'fr' } = Astro.props;
const isFr = lang === 'fr';

const credentials = [
  {
    institution: 'Université Cheikh Anta Diop (UCAD)',
    detail: isFr ? 'Licence 2 Anglais (FLSH)' : 'B.A. in English (Year 2)',
    category: isFr ? 'Cursus Universitaire' : 'Academic Degree'
  },
  {
    institution: 'Orange Digital Center / Sonatel',
    detail: isFr ? '4 Attestations officielles (Tech Academy)' : '4 Verified Certifications',
    category: 'Tech & Digital'
  },
  {
    institution: 'United Nations (UNODC) / SPARK',
    detail: isFr ? 'Certificat Cybercrime (Vérifié QR)' : 'Cybercrime Course (QR Verified)',
    category: 'International'
  },
  {
    institution: 'U.S. Embassy Dakar / Power UP',
    detail: isFr ? 'Attestation READY, SET, CAREER' : 'Career Development Program',
    category: 'Professional'
  }
];
---

<section class="credibility-strip" aria-label={isFr ? 'Partenaires et institutions de formation' : 'Institutions and credentials'}>
  <div class="site-container">
    <div class="credibility-header">
      <span class="credibility-title">
        {isFr ? 'Institutions certifiantes & Formation académique' : 'Accrediting Institutions & Academic Background'}
      </span>
      <span class="credibility-badge">
        {isFr ? 'Preuves documentaires vérifiées' : 'Documented & Verified Facts'}
      </span>
    </div>

    <div class="credibility-grid">
      {credentials.map((item) => (
        <div class="credibility-item">
          <span class="item-category">{item.category}</span>
          <strong class="item-institution">{item.institution}</strong>
          <span class="item-detail">{item.detail}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .credibility-strip {
    background-color: var(--color-canvas-subtle);
    border-bottom: 1px solid var(--color-border-subtle);
    padding: var(--space-8) 0;
  }

  .credibility-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
  }

  .credibility-title {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .credibility-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--color-verified-text);
    background-color: var(--color-verified-bg);
    border: 1px solid var(--color-verified-border);
    padding: 3px 8px;
    border-radius: var(--radius-xs);
    font-weight: var(--weight-semibold);
  }

  .credibility-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .credibility-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .credibility-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-6);
    }
  }

  .credibility-item {
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: transform var(--duration-fast) var(--ease-out-quint);
  }

  .credibility-item:hover {
    transform: translateY(-2px);
    border-color: var(--color-border-medium);
  }

  .item-category {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-accent-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: var(--weight-semibold);
  }

  .item-institution {
    font-family: var(--font-display);
    font-size: var(--font-size-sm);
    color: var(--color-text-primary);
    line-height: 1.3;
  }

  .item-detail {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    line-height: 1.4;
  }
</style>
