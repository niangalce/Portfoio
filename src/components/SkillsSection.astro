---
import skillsData from '../../content/skills.json';
import skillEvidence from '../../content/skill-evidence.json';
import projectsData from '../../content/projects.json';
import experiencesData from '../../content/experiences.json';
import certificationsData from '../../content/certifications.json';
import profileData from '../../content/profile.json';
import { sitePath } from '../utils/urls';

type EvidenceType = 'project' | 'experience' | 'certification' | 'training';
interface SkillEvidenceReference {
  type: EvidenceType;
  id: string;
}
interface ResolvedEvidenceLink {
  href: string;
  label: string;
  type: EvidenceType;
}

interface Props {
  lang?: 'fr' | 'en';
}

const { lang = 'fr' } = Astro.props;
const isFr = lang === 'fr';
const evidenceLabels: Record<EvidenceType, { fr: string; en: string }> = {
  project: { fr: 'Projet', en: 'Project' },
  experience: { fr: 'Expérience', en: 'Experience' },
  certification: { fr: 'Certification', en: 'Certification' },
  training: { fr: 'Formation', en: 'Training' }
};

const getEvidenceLinks = (skillName: string): ResolvedEvidenceLink[] => {
  const references = (skillEvidence as Record<string, SkillEvidenceReference[]>)[skillName] ?? [];
  const links: ResolvedEvidenceLink[] = [];

  for (const reference of references) {
    if (reference.type === 'project') {
      const project = projectsData.find((item) => item.id === reference.id);
        if (!project) {
          throw new Error(`Skill evidence references unknown project "${reference.id}" for "${skillName}".`);
        }
        links.push({
          href: sitePath(`${lang === 'fr' ? '' : '/en'}/projects/${project.slug}/`),
          label: project.title,
          type: reference.type
        });
        continue;
      }

      if (reference.type === 'experience') {
        const experience = experiencesData.find((item) => item.id === reference.id);
        if (!experience) {
          throw new Error(`Skill evidence references unknown experience "${reference.id}" for "${skillName}".`);
        }
        links.push({
          href: sitePath(`${lang === 'fr' ? '' : '/en/'}#experience-${experience.id}`),
          label: `${isFr ? experience.role.fr : experience.role.en} · ${experience.organization}`,
          type: reference.type
        });
        continue;
      }

      if (reference.type === 'certification') {
        const certification = certificationsData.find((item) => item.id === reference.id);
        if (!certification) {
          throw new Error(`Skill evidence references unknown certification "${reference.id}" for "${skillName}".`);
        }
        links.push({
          href: sitePath(`${lang === 'fr' ? '' : '/en/'}#certificate-${certification.id}`),
          label: certification.title,
          type: reference.type
        });
        continue;
      }

      if (reference.type !== 'training') {
        throw new Error(`Skill evidence has unknown type "${reference.type}" for "${skillName}".`);
      }

      const training = profileData.education.find((item) => item.id === reference.id);
      if (!training) {
        throw new Error(`Skill evidence references unknown training "${reference.id}" for "${skillName}".`);
      }
      links.push({
        href: sitePath(`${lang === 'fr' ? '' : '/en/'}#education-${training.id}`),
        label: isFr ? training.degree.fr : training.degree.en,
        type: reference.type
      });
    }

  return links;
};

const getStatusBadgeClass = (status: string) => {
  switch (status) {
    case 'Comfortable':
      return 'badge-comfortable';
    case 'Practicing':
      return 'badge-practicing';
    case 'Building':
      return 'badge-building';
    case 'Learning':
      return 'badge-learning';
    default:
      return 'badge-default';
  }
};

// Hiérarchie par niveau de maîtrise (statut qualitatif), toutes domaines confondus.
// Chaque compétence conserve l'étiquette de son domaine d'origine.
type SkillEntry = (typeof skillsData.categories)[number]['skills'][number] & {
  domain: { fr: string; en: string };
};

const allSkills: SkillEntry[] = skillsData.categories.flatMap((category) =>
  category.skills.map((skill) => ({ ...skill, domain: category.title }))
);

const provenSkills = allSkills.filter((skill) => skill.status === 'Comfortable');
const consolidatingSkills = allSkills.filter(
  (skill) => skill.status === 'Practicing' || skill.status === 'Building'
);
const learningSkills = allSkills.filter((skill) => skill.status === 'Learning');

const tierLabels = {
  proven: {
    fr: 'Maîtrises opérationnelles',
    en: 'Operational mastery'
  },
  consolidating: {
    fr: 'En consolidation sur les projets',
    en: 'Being consolidated on projects'
  },
  learning: {
    fr: 'En apprentissage',
    en: 'Currently learning'
  }
};

const tierNotes = {
  proven: {
    fr: 'Compétences utilisées dans les projets, les expériences et les certifications documentées.',
    en: 'Skills used across projects, experiences, and documented certifications.'
  },
  consolidating: {
    fr: 'Pratique régulière et construction active, notamment sur JËF et TèrangaDigital.',
    en: 'Regular practice and active building, notably on JËF and TèrangaDigital.'
  },
  learning: {
    fr: 'Prochaines briques explorées ; elles ne sont pas présentées comme des expertises disponibles.',
    en: 'Next building blocks being explored; not presented as available expertise.'
  }
};
---

<section id="skills" class="skills-section" aria-labelledby="skills-title">
  <div class="site-container">
    <div class="section-heading">
      <div class="heading-left">
        <p class="section-kicker">{isFr ? 'Compétences & Maîtrise' : 'Skills & Capabilities'}</p>
        <h2 id="skills-title" class="section-title">
          {isFr ? 'Des savoir-faire ancrés dans la pratique.' : 'Capabilities grounded in practice.'}
        </h2>
      </div>
      <p class="section-intro">
        {isFr
          ? 'Aucun pourcentage : chaque statut reste qualitatif. Les références vers un projet, une expérience, une certification ou une formation sont affichées lorsqu’elles existent.'
          : 'No percentages: skill statuses remain qualitative. Links to projects, experience, certifications, or education are shown where available.'}
      </p>
    </div>

    <!-- Niveau 1 : compétences éprouvées par les projets et certifications -->
    <div class="skill-tier">
      <div class="tier-header">
        <h3 class="tier-title">{isFr ? tierLabels.proven.fr : tierLabels.proven.en}</h3>
        <p class="tier-note">{isFr ? tierNotes.proven.fr : tierNotes.proven.en}</p>
      </div>
      <ul class="skill-rows">
        {provenSkills.map((skill) => {
          const evidenceLinks = getEvidenceLinks(skill.name);
          return (
            <li class="skill-row">
              <div class="skill-row-main">
                <span class="skill-name">{skill.name}</span>
                <span class="skill-domain">{isFr ? skill.domain.fr : skill.domain.en}</span>
              </div>
              {evidenceLinks.length > 0 ? (
                <ul class="skill-evidence" aria-label={isFr ? 'Preuves associées' : 'Related evidence'}>
                  {evidenceLinks.map((evidence) => (
                    <li>
                      <a href={evidence.href}>
                        <span class="evidence-type">{evidenceLabels[evidence.type][lang]}</span>
                        <span>{evidence.label}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="skill-no-evidence">
                  {isFr ? 'Aucune preuve publiée pour le moment.' : 'No published evidence yet.'}
                </p>
              )}
            </li>
          );
        })}
      </ul>
    </div>

    <!-- Niveau 2 : compétences en pratique ou en construction -->
    <div class="skill-tier">
      <div class="tier-header">
        <h3 class="tier-title">{isFr ? tierLabels.consolidating.fr : tierLabels.consolidating.en}</h3>
        <p class="tier-note">{isFr ? tierNotes.consolidating.fr : tierNotes.consolidating.en}</p>
      </div>
      <ul class="skill-rows">
        {consolidatingSkills.map((skill) => {
          const evidenceLinks = getEvidenceLinks(skill.name);
          return (
            <li class="skill-row">
              <div class="skill-row-main">
                <span class="skill-name">{skill.name}</span>
                <span class={`skill-status ${getStatusBadgeClass(skill.status)}`}>
                  {skill.status}
                </span>
                <span class="skill-domain">{isFr ? skill.domain.fr : skill.domain.en}</span>
              </div>
              <p class="skill-context">{isFr ? skill.context.fr : skill.context.en}</p>
              {evidenceLinks.length > 0 ? (
                <ul class="skill-evidence" aria-label={isFr ? 'Preuves associées' : 'Related evidence'}>
                  {evidenceLinks.map((evidence) => (
                    <li>
                      <a href={evidence.href}>
                        <span class="evidence-type">{evidenceLabels[evidence.type][lang]}</span>
                        <span>{evidence.label}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              ) : null}
            </li>
          );
        })}
      </ul>
    </div>

    <!-- Niveau 3 : compétences en cours d'apprentissage -->
    <div class="skill-tier">
      <div class="tier-header">
        <h3 class="tier-title">{isFr ? tierLabels.learning.fr : tierLabels.learning.en}</h3>
        <p class="tier-note">{isFr ? tierNotes.learning.fr : tierNotes.learning.en}</p>
      </div>
      <ul class="skill-rows skill-rows-compact">
        {learningSkills.map((skill) => (
          <li class="skill-row">
            <div class="skill-row-main">
              <span class="skill-name">{skill.name}</span>
              <span class={`skill-status ${getStatusBadgeClass(skill.status)}`}>
                {skill.status}
              </span>
              <span class="skill-domain">{isFr ? skill.domain.fr : skill.domain.en}</span>
            </div>
            <p class="skill-context">{isFr ? skill.context.fr : skill.context.en}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .skills-section {
    padding-top: var(--space-20);
    padding-bottom: var(--space-20);
    border-bottom: 1px solid var(--color-border-subtle);
    background-color: var(--color-canvas-subtle);
  }

  .section-heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-12);
  }

  @media (min-width: 960px) {
    .section-heading {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .section-kicker {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-accent-primary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-2);
  }

  .section-title {
    font-size: var(--font-size-2xl);
    font-weight: var(--weight-extrabold);
    color: var(--color-text-primary);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .section-intro {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    max-width: 480px;
    line-height: var(--leading-relaxed);
  }

  /* Niveaux de maîtrise : séparés par des filets, pas par des cartes */
  .skill-tier {
    padding-top: var(--space-8);
    margin-top: var(--space-8);
    border-top: 1px solid var(--color-border-subtle);
  }

  /* Le premier niveau suit directement l'en-tête de section : pas de filet supérieur */
  .section-heading + .skill-tier {
    padding-top: 0;
    margin-top: 0;
    border-top: 0;
  }

  .tier-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 760px) {
    .tier-header {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-6);
    }
  }

  .tier-title {
    font-family: var(--font-display);
    font-size: var(--font-size-lg);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
  }

  .tier-note {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    max-width: 460px;
  }

  /* Rangées structurées (liste éditoriale) */
  .skill-rows {
    list-style: none;
    display: flex;
    flex-direction: column;
    padding: 0;
    margin: 0;
  }

  .skill-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .skill-row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .skill-row-main {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
  }

  .skill-name {
    font-size: var(--font-size-base);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
    overflow-wrap: anywhere;
  }

  .skill-rows-compact .skill-name {
    font-size: var(--font-size-sm);
  }

  .skill-domain {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-tertiary);
  }

  .skill-status {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: var(--weight-semibold);
    padding: 2px 6px;
    border-radius: var(--radius-xs);
    white-space: nowrap;
  }

  .badge-comfortable {
    background-color: var(--color-verified-bg);
    color: var(--color-verified-text);
    border: 1px solid var(--color-verified-border);
  }

  .badge-practicing {
    background-color: var(--color-canvas-subtle);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border-medium);
  }

  .badge-building {
    background-color: var(--color-status-dev-bg);
    color: var(--color-status-dev-text);
    border: 1px solid var(--color-status-dev-border);
  }

  .badge-learning {
    background-color: var(--color-accent-tint);
    color: var(--color-accent-primary);
    border: 1px solid var(--color-accent-border);
  }

  .skill-context {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin: 0;
  }

  .skill-evidence {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skill-evidence a {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-2);
    color: var(--color-accent-primary);
    font-size: 11px;
    line-height: var(--leading-snug);
    text-decoration: underline;
    text-underline-offset: 2px;
    overflow-wrap: anywhere;
  }

  .skill-no-evidence {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 11px;
    font-style: italic;
  }

  .evidence-type {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 10px;
    text-decoration: none;
  }
</style>
