---
interface Props {
  lang?: 'fr' | 'en';
}

const { lang = 'fr' } = Astro.props;
const isFr = lang === 'fr';
const email = 'niangalce@gmail.com';
---

<section class="contact-section" aria-labelledby="contact-title">
  <div class="site-container contact-layout">
    <div class="contact-intro">
      <p class="section-kicker">{isFr ? 'Contact & collaboration' : 'Contact & collaboration'}</p>
      <h1 id="contact-title">
        {isFr ? 'Parlons de votre besoin.' : 'Let’s discuss what you need.'}
      </h1>
      <p class="contact-lead">
        {isFr
          ? 'Décrivez votre projet, une opportunité ou une idée de collaboration. Le formulaire prépare un email dans votre application de messagerie : rien n’est transmis à ce site et vous gardez la main avant l’envoi.'
          : 'Tell me about a project, opportunity, or collaboration. The form prepares an email in your mail app: nothing is sent to this website, and you review it before sending.'}
      </p>
      <a class="direct-email" href={`mailto:${email}`}>{email}</a>
    </div>

    <form
      class="contact-form"
      action={`mailto:${email}`}
      method="post"
      enctype="text/plain"
      data-contact-form
      data-recipient={email}
    >
      <div class="form-grid">
        <div class="field">
          <label for="contact-name">{isFr ? 'Nom' : 'Name'} <span aria-hidden="true">*</span></label>
          <input id="contact-name" name="name" type="text" autocomplete="name" required minlength="2" maxlength="80" />
        </div>

        <div class="field">
          <label for="contact-email">Email <span aria-hidden="true">*</span></label>
          <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254" />
        </div>

        <div class="field">
          <label for="contact-project">{isFr ? 'Entreprise / projet' : 'Company / project'}</label>
          <input
            id="contact-project"
            name="company"
            type="text"
            autocomplete="organization"
            maxlength="120"
          />
        </div>

        <div class="field">
          <label for="contact-need">{isFr ? 'Type de besoin' : 'Type of need'} <span aria-hidden="true">*</span></label>
          <select id="contact-need" name="need" required>
            <option value="">{isFr ? 'Choisir une option' : 'Choose an option'}</option>
            <option value={isFr ? 'Recrutement / stage' : 'Recruitment / internship'}>{isFr ? 'Recrutement / stage' : 'Recruitment / internship'}</option>
            <option value={isFr ? 'Site web / landing page' : 'Website / landing page'}>{isFr ? 'Site web / landing page' : 'Website / landing page'}</option>
            <option value={isFr ? 'Intégration d’interface' : 'Interface implementation'}>{isFr ? 'Intégration d’interface' : 'Interface implementation'}</option>
            <option value={isFr ? 'Communication digitale' : 'Digital communication'}>{isFr ? 'Communication digitale' : 'Digital communication'}</option>
            <option value={isFr ? 'Collaboration' : 'Collaboration'}>{isFr ? 'Collaboration' : 'Collaboration'}</option>
            <option value={isFr ? 'Autre' : 'Other'}>{isFr ? 'Autre' : 'Other'}</option>
          </select>
        </div>

        <div class="field field-full">
          <label for="contact-budget">{isFr ? 'Budget indicatif' : 'Indicative budget'}</label>
          <input
            id="contact-budget"
            name="budget"
            type="text"
            inputmode="text"
            maxlength="80"
            placeholder={isFr ? 'Montant indicatif ou à définir' : 'Indicative amount or to be discussed'}
          />
        </div>

        <div class="field field-full">
          <label for="contact-message">{isFr ? 'Message' : 'Message'} <span aria-hidden="true">*</span></label>
          <textarea id="contact-message" name="message" rows="6" required minlength="10" maxlength="2000"></textarea>
        </div>
      </div>

      <div class="honeypot" aria-hidden="true">
        <label for="contact-website">Leave this field empty</label>
        <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <p class="privacy-hint">
        {isFr
          ? 'Les champs sont utilisés uniquement pour préparer le brouillon d’email. Vérifiez-le puis envoyez-le depuis votre messagerie.'
          : 'Your entries are only used to prepare an email draft. Review and send it from your mail app.'}
      </p>
      <button class="submit-button" type="submit">
        {isFr ? 'Préparer le brouillon email' : 'Prepare email draft'}
        <span aria-hidden="true">→</span>
      </button>
      <a class="submit-button draft-link" data-draft-link hidden>
        {isFr ? 'Ouvrir le brouillon dans ma messagerie' : 'Open the draft in my mail app'}
        <span aria-hidden="true">→</span>
      </a>
      <p class="form-status" data-form-status role="status" aria-live="polite" aria-atomic="true"></p>
      <p class="form-fallback">
        {isFr ? 'Si votre messagerie ne s’ouvre pas :' : 'If your mail app does not open:'}
        <a href="mailto:niangalce@gmail.com">niangalce@gmail.com</a>
      </p>
      <noscript>
        <p class="form-fallback">
          JavaScript désactivé / JavaScript disabled :
          <a href="mailto:niangalce@gmail.com">niangalce@gmail.com</a>
        </p>
      </noscript>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  form?.addEventListener('input', () => {
    const draftLink = form.querySelector<HTMLAnchorElement>('[data-draft-link]');
    const status = form.querySelector<HTMLElement>('[data-form-status]');

    if (draftLink && !draftLink.hidden && status) {
      draftLink.hidden = true;
      draftLink.removeAttribute('href');
      status.textContent = '';
    }
  });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const honeypot = form.elements.namedItem('website');

    if (!(honeypot instanceof HTMLInputElement) || !status) {
      throw new Error('The contact form is missing its anti-spam or status field.');
    }

    if (honeypot.value.trim()) {
      status.textContent =
        document.documentElement.lang === 'fr'
          ? 'Le brouillon n’a pas pu être préparé. Utilisez le lien email direct ci-dessous.'
          : 'The draft could not be prepared. Use the direct email link below.';
      return;
    }

    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const getValue = (name: string) => String(data.get(name) ?? '').trim();
    const senderName = getValue('name');
    const senderEmail = getValue('email');
    const company = getValue('company');
    const need = getValue('need');
    const budget = getValue('budget');
    const message = getValue('message');
    const selectedNeed = form.querySelector<HTMLSelectElement>('[name="need"]')?.value;

    if (
      senderName.length < 2 ||
      !senderName ||
      !senderEmail ||
      senderEmail.length > 254 ||
      company.length > 120 ||
      !selectedNeed ||
      need !== selectedNeed ||
      budget.length > 80 ||
      message.trim().length < 10 ||
      message.length > 2000
    ) {
      status.textContent =
        document.documentElement.lang === 'fr'
          ? 'Vérifiez les champs : certaines valeurs sont trop courtes ou trop longues.'
          : 'Please check the fields: one or more values are too short or too long.';
      return;
    }

    const isFr = document.documentElement.lang === 'fr';
    const subject = `${isFr ? 'Contact portfolio' : 'Portfolio enquiry'} — ${senderName}`;
    const body = [
      `${isFr ? 'Nom' : 'Name'}: ${senderName}`,
      `Email: ${senderEmail}`,
      `${isFr ? 'Entreprise / projet' : 'Company / project'}: ${company || (isFr ? 'Non précisé' : 'Not provided')}`,
      `${isFr ? 'Type de besoin' : 'Type of need'}: ${need}`,
      `${isFr ? 'Budget indicatif' : 'Indicative budget'}: ${budget || (isFr ? 'Non précisé' : 'Not provided')}`,
      '',
      `${isFr ? 'Message' : 'Message'}:`,
      message
    ].join('\r\n');
    const recipient = form.dataset.recipient;
    const draftLink = form.querySelector<HTMLAnchorElement>('[data-draft-link]');

    if (!recipient || !draftLink) {
      throw new Error('The contact form recipient or email draft action is not configured.');
    }

    try {
      draftLink.href =
        `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      draftLink.hidden = false;
      status.textContent = isFr
        ? 'Le brouillon est prêt. Ouvrez-le avec le bouton ci-dessous, puis vérifiez-le et envoyez-le dans votre messagerie.'
        : 'Your draft is ready. Open it with the button below, then review and send it from your mail app.';
      draftLink.focus();
    } catch (error) {
      status.textContent = isFr
        ? 'Le brouillon n’a pas pu être préparé. Utilisez le lien email direct ci-dessous.'
        : 'The email draft could not be prepared. Use the direct email link below.';
      console.error('Unable to prepare a mail draft.', error);
    }
  });
</script>

<style>
  .contact-section {
    padding-block: var(--space-20);
  }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(var(--space-8), 6vw, var(--space-16));
    align-items: start;
  }

  .contact-intro {
    position: sticky;
    top: var(--space-8);
  }

  .section-kicker {
    margin-bottom: var(--space-3);
    color: var(--color-accent-primary);
    font: var(--weight-semibold) var(--font-size-xs) var(--font-mono);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  h1 {
    margin-bottom: var(--space-5);
    font-size: var(--font-size-2xl);
  }

  .contact-lead {
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .direct-email {
    display: inline-block;
    margin-top: var(--space-6);
    color: var(--color-accent-primary);
    font-weight: var(--weight-semibold);
    overflow-wrap: anywhere;
  }

  .contact-form {
    padding: clamp(var(--space-5), 4vw, var(--space-8));
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    background: var(--color-surface-card);
    box-shadow: var(--shadow-card);
  }

  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .field {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: var(--space-2);
  }

  .field-full {
    grid-column: 1 / -1;
  }

  .field label {
    font-size: var(--font-size-sm);
    font-weight: var(--weight-semibold);
  }

  .field label span {
    color: var(--color-accent-primary);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 48px;
    padding: 0.75rem;
    border: 1px solid var(--color-border-medium);
    border-radius: var(--radius-sm);
    background: var(--color-canvas-default);
    color: var(--color-text-primary);
  }

  .field textarea {
    min-height: 160px;
    resize: vertical;
  }

  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible,
  .submit-button:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }

  .privacy-hint,
  .form-fallback {
    margin-top: var(--space-4);
    color: var(--color-text-secondary);
    font-size: var(--font-size-xs);
    line-height: var(--leading-relaxed);
  }

  .submit-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
    padding: 0.75rem 1.25rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--color-accent-primary);
    color: #fff;
    cursor: pointer;
    font-weight: var(--weight-semibold);
  }

  .submit-button:hover {
    background: var(--color-accent-hover);
  }

  .draft-link {
    margin-left: var(--space-3);
    text-decoration: none;
  }

  .draft-link[hidden] {
    display: none;
  }

  .form-status {
    margin-top: var(--space-4);
    color: var(--color-verified-text);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-relaxed);
  }

  .form-fallback a {
    color: var(--color-accent-primary);
    font-weight: var(--weight-semibold);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    overflow-wrap: anywhere;
  }

  @media (max-width: 760px) {
    .contact-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .contact-intro {
      position: static;
    }
  }

  @media (max-width: 520px) {
    .form-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .field-full {
      grid-column: auto;
    }
  }
</style>
