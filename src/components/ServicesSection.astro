---
import servicesData from '../../content/services.json';
import skillsData from '../../content/skills.json';

interface Props {
  lang?: 'fr' | 'en';
}

const { lang = 'fr' } = Astro.props;
const isFr = lang === 'fr';
const inProgressCategories = skillsData.categories
  .filter((category) => ['frontend', 'backend-data', 'tools-workflow'].includes(category.id))
  .map((category) => ({
    ...category,
    skills: category.skills.filter((skill) => skill.status !== 'Comfortable')
  }))
  .filter((category) => category.skills.length > 0);

const getStatusClass = (status: string) => `status-${status.toLowerCase()}`;
---

<section id="services" class="services-section" aria-labelledby="services-title">
  <div class="site-container">
    <div class="section-heading">
      <div class="heading-left">
        <p class="section-kicker">{isFr ? 'Offres & Prestations' : 'Services & Offerings'}</p>
        <h2 id="services-title" class="section-title">
          {isFr ? 'Des solutions claires pour PME et créateurs.' : 'Concrete solutions for SMEs and creators.'}
        </h2>
      </div>
      <p class="section-intro">
        {isFr
          ? 'Une frontière étanche entre ce que je propose comme prestation opérationnelle aujourd’hui et les compétences que je consolide en apprentissage continu.'
          : 'A clear boundary between services ready for immediate deployment and technical skills currently being consolidated.'}
      </p>
    </div>

    <div class="subsection-heading">
      <p class="section-kicker">{isFr ? 'Prestations' : 'Offerings'}</p>
      <h3 id="available-services-title" class="subsection-title">
        {isFr ? 'Services disponibles' : 'Available services'}
      </h3>
    </div>

    <div class="services-grid" aria-labelledby="available-services-title">
      {servicesData.availableServices.map((service) => (
        <article class="service-card">
          <div class="service-header">
            <span class="service-availability-badge">{isFr ? 'Disponible' : 'Available'}</span>
            <h3 class="service-title">{isFr ? service.title.fr : service.title.en}</h3>
            <p class="service-tagline">{isFr ? service.tagline.fr : service.tagline.en}</p>
          </div>

          <p class="service-desc">{isFr ? service.description.fr : service.description.en}</p>

          <div class="deliverables-box">
            <h4 class="deliverables-title">{isFr ? 'Livrables concrets :' : 'Key Deliverables:'}</h4>
            <ul class="deliverables-list">
              {(isFr ? service.deliverables.fr : service.deliverables.en).map((deliv) => (
                <li>{deliv}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <div class="subsection-heading progress-heading">
      <p class="section-kicker">{isFr ? 'En progression' : 'In progress'}</p>
      <h3 id="service-skills-title" class="subsection-title">
        {isFr ? 'Technologies et compétences en progression' : 'Technologies and skills in progress'}
      </h3>
      <p class="section-intro">
        {isFr
          ? 'Ces compétences sont en apprentissage, en pratique ou en construction ; elles ne sont pas présentées comme des prestations disponibles.'
          : 'These skills are being learned, practiced, or built; they are not presented as available services.'}
      </p>
    </div>

    <div class="progress-categories" aria-labelledby="service-skills-title">
      {inProgressCategories.map((category) => (
        <article class="progress-category">
          <h4>{isFr ? category.title.fr : category.title.en}</h4>
          <ul>
            {category.skills.map((skill) => (
              <li>
                <span>{skill.name}</span>
                <span class={`progress-status ${getStatusClass(skill.status)}`}>{skill.status}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <a class="roadmap-link" href="#currently-learning">
      {isFr ? 'Voir la roadmap Full-Stack' : 'View the Full-Stack roadmap'}
      <span aria-hidden="true">→</span>
    </a>

    <div class="learning-callout-panel">
      <div class="callout-heading">
        <span class="callout-icon" aria-hidden="true">i</span>
        <div>
          <h3 class="callout-title">
            {isFr ? 'Périmètre des prestations' : 'Service scope'}
          </h3>
          <p class="callout-sub">
            {isFr
              ? 'Les offres présentées ci-dessus sont les services proposés. Les compétences techniques en progression restent identifiées séparément et ne sont pas incluses comme expertises disponibles.'
              : 'The offerings above are the services currently presented. Technical skills still in progress are listed separately and are not represented as available expertise.'}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .services-section {
    padding-top: var(--space-20);
    padding-bottom: var(--space-20);
    border-bottom: 1px solid var(--color-border-subtle);
    background-color: var(--color-canvas-subtle);
  }

  .section-heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-12);
  }

  @media (min-width: 960px) {
    .section-heading {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .section-kicker {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-accent-primary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-2);
  }

  .section-title {
    font-size: var(--font-size-2xl);
    font-weight: var(--weight-extrabold);
    color: var(--color-text-primary);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .section-intro {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    max-width: 480px;
    line-height: var(--leading-relaxed);
  }

  .subsection-heading {
    margin-bottom: var(--space-5);
  }

  .subsection-title {
    margin-bottom: var(--space-2);
    font-size: var(--font-size-lg);
    font-weight: var(--weight-bold);
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }

  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .service-card {
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
  }

  .service-header {
    margin-bottom: var(--space-4);
  }

  .service-availability-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: var(--weight-semibold);
    background-color: var(--color-verified-bg);
    color: var(--color-verified-text);
    border: 1px solid var(--color-verified-border);
    padding: 3px 8px;
    border-radius: var(--radius-xs);
    margin-bottom: var(--space-2);
  }

  .progress-heading {
    margin-top: var(--space-12);
  }

  .progress-categories {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .roadmap-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: var(--space-2);
    margin-top: calc(-1 * var(--space-6));
    margin-bottom: var(--space-10);
    color: var(--color-accent-primary);
    font-size: var(--font-size-sm);
    font-weight: var(--weight-semibold);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 768px) {
    .progress-categories {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .progress-category {
    min-width: 0;
    padding: var(--space-5);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    background: var(--color-surface-card);
  }

  .progress-category h4 {
    margin-bottom: var(--space-4);
    font-size: var(--font-size-base);
  }

  .progress-category ul {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .progress-category li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    color: var(--color-text-secondary);
    font-size: var(--font-size-xs);
  }

  .progress-status {
    padding: 2px 7px;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    background: var(--color-canvas-subtle);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 10px;
    white-space: nowrap;
  }

  .status-learning {
    border-color: var(--color-accent-border);
    background: var(--color-accent-tint);
    color: var(--color-accent-primary);
  }

  .status-practicing {
    border-color: var(--color-border-medium);
    background: var(--color-canvas-subtle);
    color: var(--color-text-secondary);
  }

  .status-building {
    border-color: var(--color-status-dev-border);
    background: var(--color-status-dev-bg);
    color: var(--color-status-dev-text);
  }

  .service-title {
    font-size: var(--font-size-md);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--space-1);
    line-height: 1.3;
  }

  .service-tagline {
    font-size: var(--font-size-xs);
    color: var(--color-accent-primary);
    font-weight: var(--weight-medium);
  }

  .service-desc {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-5);
  }

  .deliverables-box {
    margin-top: auto;
    background-color: var(--color-canvas-subtle);
    border-radius: var(--radius-sm);
    padding: var(--space-4);
    border: 1px solid var(--color-border-subtle);
  }

  .deliverables-title {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
  }

  .deliverables-list {
    list-style: square inside;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 11px;
    color: var(--color-text-secondary);
  }

  /* Panneau de Transparence */
  .learning-callout-panel {
    background-color: var(--color-surface-card);
    border: 1.5px dashed var(--color-border-medium);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
  }

  .callout-heading {
    display: flex;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .callout-icon {
    font-size: 24px;
    line-height: 1;
  }

  .callout-title {
    font-size: var(--font-size-base);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--space-1);
  }

  .callout-sub {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    max-width: 820px;
  }

</style>
