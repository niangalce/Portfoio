---
import profileData from '../../content/profile.json';
import { sitePath } from '../utils/urls';

interface Props {
  lang?: 'fr' | 'en';
}

const { lang = 'fr' } = Astro.props;
const isFr = lang === 'fr';
const { identity } = profileData;
const resumeUrl = sitePath(identity.cvDownload.relativePath);
const portraitUrl = sitePath(identity.heroPortrait.relativePath);
---

<section class="hero-section" aria-labelledby="hero-title">
  <div class="site-container hero-grid">
    <!-- Colonne Contenu Éditorial & Preuves -->
    <div class="hero-content">
      <!-- Sur-titre discret d'ancrage local & académique -->
      <p class="hero-origin">
        <span class="origin-dot" aria-hidden="true"></span>
        <span>{isFr ? 'Dakar, Sénégal · Licence 2 Anglais (UCAD)' : 'Dakar, Senegal · English Major (UCAD)'}</span>
      </p>

      <div class="hero-identity">
        <img
          src={portraitUrl}
          alt={isFr ? identity.heroPortrait.alt.fr : identity.heroPortrait.alt.en}
          width={identity.heroPortrait.width}
          height={identity.heroPortrait.height}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="hero-avatar"
        />
        <h1 id="hero-title" class="hero-title">{identity.fullName}</h1>
      </div>

      <!-- Sous-titre de positionnement clair & net -->
      <p class="hero-role">
        {isFr ? identity.titles.fr : identity.titles.en}
      </p>

      <!-- Proposition de valeur humaine et concrète (sans buzzwords) -->
      <p class="hero-pitch">
        {isFr
          ? 'Je conçois des produits web utiles, de l’interface au fonctionnement, avec un souci constant de clarté, d’expérience utilisateur et de faisabilité concrète. Mon parcours associe apprentissage du web, projets personnels, logique produit et communication digitale.'
          : 'I design useful web products from interface to functionality, with a constant focus on clarity, user experience, and practical delivery. My path combines self-learning, personal projects, product thinking, and digital communication.'}
      </p>

      <!-- Les 2 CTAs complémentaires (Primaire : Projets / Secondaire : CV) -->
      <div class="hero-actions">
        <a href="#projects" class="btn-primary">
          <span>{isFr ? 'Explorer les réalisations' : 'Explore Projects'}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a
          href={resumeUrl}
          download
          class="btn-secondary"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>{isFr ? 'Télécharger le CV (PDF)' : 'Download Resume (PDF)'}</span>
        </a>
      </div>

      <!-- Bandeau de Preuves Vérifiées directement rattaché au Hero -->
      <div class="hero-proofs">
        <div class="proof-item">
          <span class="proof-number">L2</span>
          <span class="proof-label">{isFr ? 'Anglais UCAD en cours' : 'English Degree (UCAD)'}</span>
        </div>
        <div class="proof-separator" aria-hidden="true">/</div>
        <div class="proof-item">
          <span class="proof-number">6</span>
          <span class="proof-label">{isFr ? 'Certifications officielles' : 'Verified Certificates'}</span>
        </div>
        <div class="proof-separator" aria-hidden="true">/</div>
        <div class="proof-item">
          <span class="proof-number">100%</span>
          <span class="proof-label">{isFr ? 'Faits réels & vérifiés' : 'Fact-checked profile'}</span>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .hero-section {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--color-border-subtle);
    background: var(--color-canvas-default);
  }

  @media (min-width: 960px) {
    .hero-section {
      padding-top: var(--space-20);
      padding-bottom: var(--space-24);
    }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
  }

  /* Contenu Hero */
  .hero-content {
    display: flex;
    flex-direction: column;
    max-width: 860px;
  }

  .hero-identity {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .hero-avatar {
    flex: 0 0 auto;
    width: clamp(4rem, 8vw, 6rem);
    aspect-ratio: 1;
    height: auto;
    object-fit: cover;
    object-position: center top;
    border: 1px solid var(--color-border-medium);
    border-radius: 50%;
  }

  .hero-origin {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--weight-medium);
    color: var(--color-accent-primary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-3);
  }

  .origin-dot {
    width: 8px;
    height: 8px;
    background-color: var(--color-accent-primary);
    border-radius: 50%;
    display: inline-block;
  }

  .hero-title {
    min-width: 0;
    font-size: clamp(2rem, 7vw, 4.25rem);
    font-weight: var(--weight-extrabold);
    color: var(--color-text-primary);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .hero-role {
    font-family: var(--font-display);
    font-size: var(--font-size-lg);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
    line-height: var(--leading-snug);
    margin-bottom: var(--space-5);
  }

  .hero-pitch {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 580px;
    margin-bottom: var(--space-8);
  }

  /* CTAs complémentaires */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background-color: var(--color-accent-primary);
    color: var(--color-text-inverse);
    font-size: var(--font-size-sm);
    font-weight: var(--weight-semibold);
    padding: 14px 24px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-out-quint),
                transform var(--duration-fast) var(--ease-out-quint);
    min-height: 48px;
  }

  .btn-primary:hover {
    background-color: var(--color-accent-hover);
    transform: translateY(-2px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background-color: var(--color-surface-card);
    color: var(--color-text-primary);
    font-size: var(--font-size-sm);
    font-weight: var(--weight-semibold);
    padding: 13px 22px;
    border: 1.5px solid var(--color-border-medium);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out-quint),
      border-color var(--duration-fast) var(--ease-out-quint),
      color var(--duration-fast) var(--ease-out-quint),
      transform var(--duration-fast) var(--ease-out-quint);
    min-height: 48px;
  }

  .btn-secondary:hover {
    border-color: var(--color-text-primary);
    background-color: var(--color-canvas-subtle);
    transform: translateY(-1px);
  }

  /* Bandeau de Preuves */
  .hero-proofs {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-subtle);
    flex-wrap: wrap;
  }

  .proof-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .proof-number {
    font-family: var(--font-display);
    font-size: var(--font-size-md);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    line-height: 1;
  }

  .proof-label {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
  }

  .proof-separator {
    color: var(--color-border-medium);
    font-family: var(--font-mono);
    user-select: none;
  }

  @media (max-width: 400px) {
    .hero-identity {
      gap: var(--space-3);
    }

    .hero-avatar {
      width: 3.75rem;
    }

    .hero-title {
      font-size: clamp(1.875rem, 8vw, 2.25rem);
    }
  }
</style>
