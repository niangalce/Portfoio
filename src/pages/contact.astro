---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactPanel from '../components/ContactPanel.astro';
---

<BaseLayout
  title="Contact — Alce Niang | Portfolio"
  description="Contactez Alce Niang par email pour une opportunité, un projet web ou une collaboration."
  lang="fr"
>
  <Header slot="header" lang="fr" currentPath="/contact/" />
  <ContactPanel lang="fr" />
  <Footer slot="footer" lang="fr" />
</BaseLayout>
