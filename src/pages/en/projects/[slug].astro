---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ProjectCaseStudy from '../../../components/ProjectCaseStudy.astro';
import projectsData from '../../../../content/projects.json';

const caseStudyProjects = projectsData.filter(
  (project) => project.id === 'jef' || project.id === 'terangadigital'
);

export function getStaticPaths() {
  return projectsData
    .filter((project) => project.id === 'jef' || project.id === 'terangadigital')
    .map((project) => ({
      params: { slug: project.slug },
      props: { projectId: project.id }
    }));
}

const { projectId } = Astro.props;
const project = caseStudyProjects.find((item) => item.id === projectId);
if (!project) throw new Error(`Missing project data for "${projectId}".`);
---

<BaseLayout
  title={`${project.title} — Alce Niang`}
  description={project.tagline.en}
  lang="en"
>
  <Header slot="header" lang="en" currentPath={`/en/projects/${project.slug}/`} />
  <ProjectCaseStudy projectId={project.id} lang="en" />
  <Footer slot="footer" lang="en" />
</BaseLayout>
